# Copy to .env and fill in. .env is gitignored.

# ---- App -------------------------------------------------------------
APP_NAME="RAG Chatbot"
DEBUG=true
DATA_DIR=./data
MAX_UPLOAD_MB=25

# ---- Providers -------------------------------------------------------
# Only implemented value for both is "gemini". Anything else fails at
# startup rather than at the first API call.
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# Retrieval: hybrid | dense | keyword. Measured equal on the sample corpus;
# run `python -m eval.run` against your own.
SEARCH_MODE=hybrid

# ---- Models ----------------------------------------------------------
# Free-tier quotas differ sharply per model. gemini-3.8-flash allows only 20
# generate_content requests PER DAY and measured 15-35s per answer;
# gemini-3.5-flash answered in ~1.4s with quota to spare. Check
# https://ai.dev/rate-limit for your own limits.
LLM_MODEL=gemini-3.5-flash
# Thinking tokens are drawn from LLM_MAX_OUTPUT_TOKENS, so a thinking model
# can spend the whole budget reasoning and return nothing. 0 disables it.
LLM_THINKING_BUDGET=0
LLM_MAX_OUTPUT_TOKENS=2048
EMBEDDING_MODEL=gemini-embedding-001
# Changing this invalidates every stored vector and requires a re-index.
EMBEDDING_DIMENSIONS=768

# ---- Credentials -----------------------------------------------------
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
