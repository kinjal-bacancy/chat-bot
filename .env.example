# Copy to .env and fill in. .env is gitignored.

# ---- App -------------------------------------------------------------
APP_NAME="RAG Chatbot"
DEBUG=true
DATA_DIR=./data

# ---- Provider selection ---------------------------------------------
# Which implementation to use. Swappable without touching pipeline code.
# embedding: local | voyage
# llm:       anthropic | ollama
EMBEDDING_PROVIDER=local
LLM_PROVIDER=anthropic

# ---- Credentials (only needed for the provider you select) ----------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
